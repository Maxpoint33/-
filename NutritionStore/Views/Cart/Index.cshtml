@model IEnumerable<CartItem>
@{
    ViewData["Title"] = "Your Cart 🛒";
    var products = ViewBag.Products as List<Product>;
}

<h2 class="mb-4 text-center fw-bold animate__animated animate__fadeInDown text-white">🛒 Your Shopping Cart</h2>

@if (!Model.Any())
{
    <div class="text-center text-muted mt-5">
        <h4>Your cart is empty! 🛒😢</h4>
        <a asp-controller="Products" asp-action="All" class="btn btn-success mt-3">Browse Products</a>
    </div>
}
else
{
    <div class="card bg-dark p-4 animate__animated animate__fadeIn">
        <table class="table table-dark table-striped">
            <thead>
                <tr>
                    <th>Product</th>
                    <th class="text-center">Price</th>
                    <th class="text-center">Quantity</th>
                    <th class="text-center">Total</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var product = products.FirstOrDefault(p => p.Id == item.ProductId);
                    if (product != null)
                    {
                        <tr>
                            <td>@product.Name</td>
                            <td class="text-center">@product.Price.ToString("C")</td>
                            <td class="text-center">
                                <form asp-action="UpdateQuantity" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="actionType" value="decrease" />
                                    <button type="submit" class="btn btn-sm btn-secondary">➖</button>
                                </form>

                                <span class="mx-2">@item.Quantity</span>

                                <form asp-action="UpdateQuantity" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="actionType" value="increase" />
                                    <button type="submit" class="btn btn-sm btn-secondary">➕</button>
                                </form>
                            </td>
                            <td class="text-center">@((product.Price * item.Quantity).ToString("C"))</td>
                            <td class="text-center">
                                <form asp-action="Remove" method="post">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-danger btn-sm">❌ Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <div class="text-end mt-4">
            <h4 class="text-success">
                Total: @Model.Sum(i => products.FirstOrDefault(p => p.Id == i.ProductId)?.Price * i.Quantity ?? 0).ToString("C")
            </h4>

            <form asp-action="Checkout" method="post" class="mt-3">
                <button type="submit" class="btn btn-success btn-lg">✅ Proceed to Checkout</button>
            </form>
        </div>
    </div>
}
